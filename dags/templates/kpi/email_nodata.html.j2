{#- No-data email body. Port of emails/test/no-data.blade.php -#}
{% set text = {
    'es': {
        'greeting': 'Hola,',
        'body': 'Este mes no disponemos de los datos completos en Bifarmaeco para poder generar los informes correspondientes a <strong>' ~ nombreFarmacia ~ '</strong> (<strong>' ~ mesRango ~ '</strong>).<br><br>Una vez se resuelva el envío de datos, podrás consultar la información actualizada directamente en la plataforma: <a href="https://bifarmaeco.com/">bifarmaeco.com</a>.<br><br>Aprovechamos para recordarte que el servidor debe permanecer encendido y, en caso de cambio de servidor o compañía telefónica, es importante comunicarlo al equipo de IT de Ecoceutics.<br><br>El próximo mes recibirás el informe con normalidad.',
        'noreply': 'Por favor, no respondas a este correo, ya que no está habilitado para recibir respuestas.',
        'thanks': 'Gracias,',
        'bye': 'Saludos.'
    },
    'ca': {
        'greeting': 'Hola,',
        'body': "Aquest mes no disposem de les dades completes a Bifarmaeco per a poder generar els informes corresponents a <strong>" ~ nombreFarmacia ~ "</strong> (<strong>" ~ mesRango ~ "</strong>).<br><br>Una vegada estigui solucionat l’enviament de dades, podràs consultar la informació actualitzada directament en la plataforma: <a href=\"https://bifarmaeco.com/\">bifarmaeco.com</a>.<br><br>Aprofitem l’ocasió per a recordar-te que el servidor ha de romandre encès i, en cas de canvi de servidor o companyia telefònica, és important comunicar-ho a l’equip d’IT d’Ecoceutics.<br><br>El mes vinent rebràs l’informe amb normalitat.",
        'noreply': 'Si us plau, no responguis a aquest correu, ja que no es troba habilitat per a rebre respostes.',
        'thanks': 'Gràcies,',
        'bye': 'Salutacions.'
    }
} %}
{% set t = text.get(locale, text['es']) %}
<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Informe no disponible</title></head>
<body style="font-family: 'Montserrat', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; line-height: 1.6; color: #333; padding: 20px;">
    <div style="margin-bottom: 20px;">
        <img src="{{ logo }}" alt="Ecoceutics" style="max-height: 80px;">
    </div>
    <p>{{ t['greeting'] }}</p>
    <p>{{ t['body'] | safe }}</p>
    <p style="color: #888; font-size: 0.95em;">{{ t['noreply'] }}</p>
    <p>{{ t['thanks'] }}<br>{{ t['bye'] }}</p>
</body>
</html>
